<!DOCTYPE html>
<html lang="pt-br" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MizinhaDuCorte</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        colors: {
                            brand: '#EAB308',
                            brandHover: '#CA8A04'
                        }
                    }
                }
            }
    </script>
    <script>
            // Inicializa o Tema antes da página renderizar para evitar flickering
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
    </script>
    <style>
            html {
                scroll-behavior: smooth;
            }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Fixo -->
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 shadow-sm transition-colors duration-300">
        <nav class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-2xl font-black tracking-tighter text-slate-900 dark:text-white flex items-center gap-1">
                <span class="text-brand">MIZINHA</span>DUCORTE
            </a>

            <div class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-700 dark:text-slate-300">
                <a href="#sobre" class="hover:text-brand transition">Sobre</a>
                <a href="#servicos" class="hover:text-brand transition">Serviços</a>
                <a href="#produtos" class="hover:text-brand transition">Produtos</a>
                <a href="#localizacao" class="hover:text-brand transition">Localização</a>
                <a href="#agendar" class="hover:text-brand transition">Agendar</a>
            </div>

            <div class="flex items-center gap-4 text-slate-700 dark:text-slate-300">
                <a href="https://wa.me/5516999999999" target="_blank" class="text-green-500 text-xl hover:scale-110 transition" title="WhatsApp">
                    <i class="ph-fill ph-whatsapp-logo"></i>
                </a>
                <button id="btn-toggle-theme" class="text-xl hover:text-brand transition p-1" title="Alternar Modo Claro/Escuro">
                    <i class="ph-bold ph-moon dark:hidden"></i>
                    <i class="ph-bold ph-sun hidden dark:inline"></i>
                </button>
                <a asp-controller="Admin" asp-action="Login" class="flex items-center gap-1 font-bold text-sm text-slate-800 dark:text-slate-100 hover:text-brand transition border border-slate-300 dark:border-slate-700 px-3 py-1.5 rounded-lg shadow-sm">
                    <i class="ph-bold ph-sign-in"></i> Login
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Rodapé -->
    <footer class="bg-[#0b1329] text-white py-12 border-t border-slate-800">
        <div class="max-w-4xl mx-auto text-center space-y-6 px-4">
            <h2 class="text-2xl font-black tracking-tighter">
                <span class="text-brand">MIZINHA</span>DUCORTE
            </h2>
            <p class="text-slate-400 text-sm">Onde tradição e estilo se encontram.</p>

            <div class="flex justify-center gap-6 text-xl text-slate-300">
                <a href="#" class="hover:text-brand transition"><i class="ph-bold ph-instagram-logo"></i></a>
                <a href="#" class="hover:text-brand transition"><i class="ph-bold ph-facebook-logo"></i></a>
                <a href="#" class="hover:text-brand transition"><i class="ph-bold ph-whatsapp-logo"></i></a>
            </div>

            <div class="text-xs text-slate-500 pt-6 border-t border-slate-800/60 space-y-1">
                <p>&copy; @DateTime.Now.Year MizinhaDuCorte. Todos os direitos reservados.</p>
                <p>Desenvolvido por <span class="text-slate-400 font-semibold">Kayky Vieira</span></p>
            </div>
        </div>
    </footer>

    <script>
            document.getElementById('btn-toggle-theme')?.addEventListener('click', () => {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>