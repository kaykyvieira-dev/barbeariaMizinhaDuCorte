@using MizinhaDuCorte.Models
@{
    ViewData["Title"] = "Nova Venda - Balcão";
    Layout = null;
    var produtos = ViewBag.Produtos as List<Produto> ?? new List<Produto>();
}

<!DOCTYPE html>
<html lang="pt-br" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Venda Balcão - MizinhaDuCorte</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: { colors: { brand: '#EAB308' } }
                }
            }
    </script>
    <script>
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
    </script>
</head>
<body class="bg-[#f1f5f9] dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex items-center justify-center p-4 transition-colors">

    <div class="w-full max-w-lg bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-8 rounded-3xl shadow-xl space-y-6">

        <!-- Cabeçalho -->
        <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">
                    Venda Rápida de <span class="text-brand">Balcão</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Baixa automática de estoque e registro de balcão.</p>
            </div>
            <a href="/Admin/Index" class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="Voltar ao Painel">
                <i class="ph-bold ph-x text-lg"></i>
            </a>
        </div>

        <!-- Alerta de Erro se houver -->
        @if (TempData["Erro"] != null)
        {
            <div class="bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 p-3 rounded-xl text-xs font-semibold">
                @TempData["Erro"]
            </div>
        }

        <!-- Formulário -->
        <form method="post" action="/Admin/RegistrarVendaBalcao" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Nome do Cliente (Opcional)</label>
                <input type="text" name="nomeCliente" placeholder="Ex: João da Silva" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-slate-800 dark:text-white text-sm focus:outline-none focus:border-brand transition" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">WhatsApp / Telefone (Opcional)</label>
                <input type="tel" name="telefone" placeholder="(16) 99999-9999" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-slate-800 dark:text-white text-sm focus:outline-none focus:border-brand transition" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Selecione o Produto *</label>
                <select name="produtoId" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-slate-800 dark:text-white text-sm focus:outline-none focus:border-brand transition">
                    <option value="" disabled selected>Escolha o produto disponível...</option>
                    @foreach (var p in produtos)
                    {
                        <option value="@p.Id">@p.Nome - R$ @p.Preco.ToString("N2") (Estoque: @p.Quantidade)</option>
                    }
                </select>
                <span class="text-[10px] text-slate-400 mt-1 block">Apenas produtos com estoque maior que zero são exibidos.</span>
            </div>

            <div class="flex gap-3 pt-4">
                <a href="/Admin/Index" class="w-1/2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold py-3.5 rounded-xl text-center text-sm hover:opacity-80 transition">
                    Cancelar
                </a>
                <button type="submit" class="w-1/2 bg-brand text-slate-950 font-black py-3.5 rounded-xl text-sm hover:bg-brandHover transition shadow-lg shadow-brand/20">
                    Concluir Venda
                </button>
            </div>
        </form>
    </div>

</body>
</html>